---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  data-stepper
  class="mx-auto max-w-2xl px-gutter py-section"
>
  {
    /* Label and bar show on question steps only, and are filled in by the
       script so nothing shows a wrong count before it runs. `invisible`
       rather than `hidden` keeps the steps from shifting as they come and go. */
  }
  <div class="mb-12 flex flex-col gap-3">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-sm tracking-eyebrow text-ink-500 uppercase">{title}</h1>
      <p
        data-progress-label
        aria-hidden="true"
        class="invisible text-sm text-ink-500"
      >
      </p>
    </div>
    <progress
      data-progress-bar
      aria-label="Progress"
      value="0"
      class="invisible h-1 w-full"
    ></progress>
  </div>

  <slot />

  <nav
    data-nav
    aria-label="Steps"
    class="invisible mt-14 flex items-center justify-between gap-4"
  >
    <button
      type="button"
      data-back
      class="py-4 text-sm font-semibold tracking-[0.14em] text-ink-700 uppercase underline underline-offset-4"
    >
      Back
    </button>
    <button
      type="button"
      data-next
      class="rounded-control bg-olive-600 px-10 py-4 text-sm font-semibold tracking-[0.14em] text-paper-50 uppercase transition-[background-color] duration-150 hover:bg-olive-700"
    >
      Next
    </button>
  </nav>
</div>

<script>
  import { moveStep, resolveStep, stepHash } from '../../lib/steps';

  const root = document.querySelector<HTMLElement>('[data-stepper]');
  const steps = [...(root?.querySelectorAll<HTMLElement>('[data-step]') ?? [])];
  const label = root?.querySelector<HTMLElement>('[data-progress-label]');
  const bar = root?.querySelector<HTMLProgressElement>('[data-progress-bar]');
  const nav = root?.querySelector<HTMLElement>('[data-nav]');
  const back = root?.querySelector<HTMLButtonElement>('[data-back]');
  const next = root?.querySelector<HTMLButtonElement>('[data-next]');

  if (root && steps.length && label && bar && nav && back && next) {
    const questions = steps.filter((step) =>
      step.hasAttribute('data-question'),
    );
    const defaultNextLabel = next.textContent.trim();
    const current = () => resolveStep(location.hash, steps.length);

    // moveFocus marks a real step change; only those scroll, animate and
    // move focus.
    const render = (index: number, moveFocus: boolean) => {
      const update = () => {
        steps.forEach((step, i) => (step.hidden = i !== index));
        const question = questions.indexOf(steps[index]);
        const isQuestion = question >= 0;
        label.classList.toggle('invisible', !isQuestion);
        bar.classList.toggle('invisible', !isQuestion);
        if (isQuestion) {
          label.textContent = `Question ${question + 1} of ${questions.length}`;
          bar.max = questions.length;
          bar.value = question + 1;
          // Read as the question, not as a percentage.
          bar.setAttribute('aria-valuetext', label.textContent);
        }
        const position = steps[index].querySelector('[data-step-position]');
        if (position)
          position.textContent = isQuestion ? `${label.textContent}: ` : '';
        next.textContent = steps[index].dataset.nextLabel ?? defaultNextLabel;
        back.classList.toggle('invisible', index === 0);
        next.classList.toggle('invisible', index === steps.length - 1);
        // Instant, overriding the global smooth scroll, so the new snapshot
        // is taken at the top.
        if (moveFocus) window.scrollTo({ top: 0, behavior: 'instant' });
      };
      const focus = () =>
        steps[index]
          .querySelector<HTMLElement>('h2')
          ?.focus({ preventScroll: true });

      if (!moveFocus) return update();
      if (!document.startViewTransition) {
        update();
        return focus();
      }
      // Focus only once the transition is done; the old step is a snapshot
      // until then.
      document.startViewTransition(update).finished.finally(focus);
    };

    // Rewrites an out-of-range hash without adding a history entry.
    const show = (moveFocus: boolean) => {
      const index = current();
      if (location.hash !== stepHash(index))
        history.replaceState(null, '', stepHash(index));
      render(index, moveFocus);
    };

    // A step that would not move adds no history entry, so a double tap on
    // the last step costs the back button nothing.
    const go = (delta: number) => {
      const from = current();
      const to = moveStep(from, delta, steps.length);
      if (to !== from) location.hash = stepHash(to);
    };
    back.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    window.addEventListener('hashchange', () => show(true));

    show(false);
    nav.classList.remove('invisible');
  }
</script>
