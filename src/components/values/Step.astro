---
interface Props {
  title: string;
  first?: boolean;
  gate?: boolean;
}

const { title, first = false, gate = false } = Astro.props;
---

<section
  data-step
  data-gate={gate ? '' : undefined}
  hidden={!first}
  class="flex flex-col gap-8"
>
  <h2
    tabindex="-1"
    class="text-display-lg leading-[1.1]"
  >
    {
      /* Filled in by the Stepper, so focusing the heading announces position. */
    }
    <span
      data-step-position
      class="sr-only"
    ></span>
    {title}
  </h2>
  <div class="flex flex-col gap-5 text-lg leading-[1.65] text-ink-700">
    <slot />
  </div>
</section>
