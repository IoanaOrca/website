---
interface Props {
  title: string;
  hidden?: boolean;
  /* Counts towards "Question X of N" and gets lines to write answers on. */
  isQuestion?: boolean;
  /* Replaces the Next button's text while this step is showing. */
  nextLabel?: string;
}

const { title, hidden = false, isQuestion = false, nextLabel } = Astro.props;
---

<section
  data-step
  data-question={isQuestion ? '' : undefined}
  data-next-label={nextLabel}
  hidden={hidden}
  class="flex flex-col gap-8"
>
  <h2
    tabindex="-1"
    class="text-display-lg leading-[1.1]"
  >
    {
      /* Filled in by the Stepper, so focusing the heading announces position. */
    }
    <span
      data-step-position
      class="sr-only"
    ></span>
    {title}
  </h2>
  <div class="flex flex-col gap-5 text-lg leading-[1.65] text-ink-700">
    <slot />
  </div>
  {
    isQuestion && (
      <div
        aria-hidden="true"
        class="flex flex-col gap-2"
      >
        {[1, 2, 3].map((n) => (
          <div class="flex h-12 items-end border-b border-paper-200 pb-2 text-ink-500">
            {n}.
          </div>
        ))}
      </div>
    )
  }
</section>
