---
interface Props {
  source: string;
  heading: string;
  successHeading: string;
  successText: string;
  /* Adds an optional first-name input above the email. */
  showFirstNameField?: boolean;
  class?: string;
}

const {
  source,
  heading,
  successHeading,
  successText,
  showFirstNameField = false,
  class: className,
} = Astro.props;
---

{
  /*
  Both states share one grid cell, so the card is always as tall as the form
  and swapping in the confirmation cannot collapse it. The form is hidden with
  `invisible` rather than `hidden` for the same reason: it has to keep
  occupying the cell. The swap is driven by `data-done` on the card so a page
  can show the success state without a submit.
*/
}
<div
  id="signup-card"
  data-source={source}
  class:list={['group grid rounded-card bg-paper-50 p-card', className]}
>
  <form
    id="signup"
    novalidate
    class="col-start-1 row-start-1 flex flex-col gap-4.5 group-data-done:invisible"
  >
    <h3 class="font-display text-display-md leading-[1.2]">
      {heading}
    </h3>

    {
      /*
      Honeypot. Off-screen rather than display:none, which naive bots skip.
      Never rename it to website/url/name: password managers fill those and
      ignore autocomplete="off", and a filled honeypot discards a real signup.
    */
    }
    <div
      aria-hidden="true"
      class="absolute -left-[9999px]"
    >
      <label for="subject">Subject</label>
      <input
        id="subject"
        name="subject"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    {
      showFirstNameField && (
        <>
          <label
            for="first-name"
            class="mt-3.5 text-xs tracking-[0.16em] text-ink-500 uppercase"
          >
            First name (optional)
          </label>
          <input
            id="first-name"
            name="first-name"
            type="text"
            autocomplete="given-name"
            class="rounded-control border border-ink-500 bg-paper-50 px-4 py-4 text-base"
          />
        </>
      )
    }

    <label
      for="email"
      class="mt-3.5 text-xs tracking-[0.16em] text-ink-500 uppercase"
    >
      Email
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="you@email.com"
      class="rounded-control border border-ink-500 bg-paper-50 px-4 py-4 text-base placeholder:text-ink-500 aria-invalid:border-peach-700"
    />
    <p
      id="email-error"
      role="alert"
      hidden
      class="text-sm text-peach-700"
    >
    </p>

    <button
      type="submit"
      class="mt-2 w-full rounded-control bg-olive-600 py-4 text-sm font-semibold tracking-[0.14em] text-paper-50 uppercase transition-[background-color] duration-150 hover:bg-olive-700 disabled:cursor-default disabled:opacity-70"
    >
      Join the list
    </button>

    {
      /*
      Request status, as opposed to field status: what the server did, not what
      the address looks like. sr-only while empty keeps it out of flow, so it
      adds no gap to the flex column until it has something visible to say.
    */
    }
    <p
      id="signup-status"
      role="status"
      class="sr-only text-sm text-peach-700"
    >
    </p>
  </form>

  {
    /*
    Centred, not top-aligned: the grid cell is as tall as the form, so the
    leftover space reads as whitespace rather than a truncated card.
  */
  }
  <div
    id="signup-success"
    class="invisible col-start-1 row-start-1 flex flex-col justify-center gap-4 group-data-done:visible"
  >
    <h3
      id="signup-success-heading"
      tabindex="-1"
      class="font-display text-display-md leading-[1.2]"
    >
      {successHeading}
    </h3>
    <p class="text-base text-ink-700">
      {successText}
    </p>
  </div>
</div>

<script>
  import { PUBLIC_SUBSCRIBE_URL } from 'astro:env/client';

  import { isValidEmail, subscribe } from '../lib/subscribe';

  const INVALID_MESSAGE = 'That doesn’t look like an email address.';
  const FAILURE_MESSAGE = 'Something went wrong. Please try again.';
  const PENDING_MESSAGE = 'Sending…';

  const card = document.querySelector<HTMLElement>('#signup-card');
  const form = document.querySelector<HTMLFormElement>('#signup');
  const heading = document.querySelector<HTMLElement>(
    '#signup-success-heading',
  );
  const email = document.querySelector<HTMLInputElement>('#email');
  // Absent when the page renders the form without it.
  const firstName = document.querySelector<HTMLInputElement>('#first-name');
  const honeypot = document.querySelector<HTMLInputElement>('#subject');
  const error = document.querySelector<HTMLElement>('#email-error');
  const status = document.querySelector<HTMLElement>('#signup-status');
  const button = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  // Registered before the guard below: if any id is ever mistyped the guard
  // skips the real handler, and a form with no action and novalidate would then
  // GET-submit, putting the address in the URL, history and server logs.
  form?.addEventListener('submit', (event) => event.preventDefault());

  if (
    card &&
    form &&
    heading &&
    email &&
    honeypot &&
    error &&
    status &&
    button
  ) {
    let hasAttempted = false;

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
      email.setAttribute('aria-invalid', 'true');
      email.setAttribute('aria-describedby', 'email-error');
    };

    const clearError = () => {
      error.hidden = true;
      error.textContent = '';
      email.removeAttribute('aria-invalid');
      email.removeAttribute('aria-describedby');
    };

    // Announced by the live region either way; `visible` only decides whether
    // sighted users see it, since the button already reads Sending….
    const setStatus = (message: string, visible: boolean) => {
      status.textContent = message;
      status.classList.toggle('sr-only', !visible);
    };

    const clearStatus = () => setStatus('', false);

    email.addEventListener('blur', () => {
      if (!hasAttempted) return;
      if (isValidEmail(email.value)) clearError();
      else showError(INVALID_MESSAGE);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      hasAttempted = true;

      if (!isValidEmail(email.value)) {
        showError(INVALID_MESSAGE);
        clearStatus();
        email.focus();
        return;
      }

      clearError();
      setStatus(PENDING_MESSAGE, false);
      button.disabled = true;
      button.textContent = PENDING_MESSAGE;

      const result = await subscribe(PUBLIC_SUBSCRIBE_URL, {
        email: email.value,
        firstName: firstName?.value ?? '',
        honeypot: honeypot.value,
        source: card.dataset.source ?? '',
      });

      if (result.ok) {
        // Left visible, a failure message would keep padding the grid row.
        clearStatus();
        card.dataset.done = '';
        // Only once it is visible: a hidden subtree refuses focus outright.
        heading.focus();
        card.dispatchEvent(
          new CustomEvent('signup:success', { bubbles: true }),
        );
        return;
      }

      button.disabled = false;
      button.textContent = 'Join the list';

      if (result.reason === 'invalid') {
        showError(INVALID_MESSAGE);
        clearStatus();
        email.focus();
        return;
      }

      // A dead network says nothing about the address, so the field keeps its
      // valid state and the message goes to the region that owns the request.
      setStatus(FAILURE_MESSAGE, true);
      // Disabling the button dropped focus to <body> if it was the thing
      // focused; submitting with Enter leaves focus in the input, so restoring
      // it unconditionally would move someone who never left the field.
      if (document.activeElement === document.body) button.focus();
    });
  }
</script>
